# 依赖（不要上传）
node_modules/

# 构建产物
# dist/ 是「预编译静态产物」，为了让上游 owner 免构建直接部署，已入库；
# 重新构建：npm install && npm run build（构建后 scripts/relativize.mjs 会自动把根绝对路径改成相对路径）。
.astro/

# 日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 环境变量
.env
.env.production
.env.local

# 编辑器 / 系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
